  "components": {
    "schemas": {
      "AnalysisDecision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "BUY",
              "HOLD",
              "SELL"
            ],
            "title": "Action"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "risk_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risk Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "confidence",
          "approved",
          "risk_notes"
        ],
        "title": "AnalysisDecision"
      },
      "AnalysisDetails": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "title": "Summary"
          },
          "trend_direction": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Trend Direction"
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "news_summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "News Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "AnalysisDetails"
      },
      "AnalysisProvenance": {
        "properties": {
          "provider": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Model"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "model",
          "tools"
        ],
        "title": "AnalysisProvenance"
      },
      "AnalyzeRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "enum": [
              "9984.T",
              "6981.T"
            ],
            "title": "Symbol",
            "default": "9984.T"
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "const": "standard",
            "title": "Mode",
            "default": "standard"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "symbol": {
            "type": "string",
            "enum": [
              "9984.T",
              "6981.T"
            ],
            "title": "Symbol"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "facts": {
            "additionalProperties": true,
            "type": "object",
            "title": "Facts"
          },
          "analysis": {
            "$ref": "#/components/schemas/AnalysisDetails"
          },
          "decision": {
            "$ref": "#/components/schemas/AnalysisDecision"
          },
          "provenance": {
            "$ref": "#/components/schemas/AnalysisProvenance"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "symbol",
          "as_of",
          "facts",
          "analysis",
          "decision",
          "provenance",
          "warnings"
        ],
        "title": "AnalyzeResponse"
      },

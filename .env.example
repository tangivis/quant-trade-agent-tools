# quant_trade services
QUANT_TRADE_API_URL=http://127.0.0.1:5188
QUANT_TRADE_AGENT_URL=http://127.0.0.1:8003
QUANT_TRADE_API_TOKEN=

# Optional REST Agent Gateway
TRADE_AGENT_API_TOKEN=
TRADE_AGENT_ORCHESTRATION_MODE=native
TRADE_AGENT_MAX_HISTORY=20

# Optional standalone model runtime
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Vendor keys are used when LLM_API_KEY is empty
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# Explicit opt-in staging smoke; disabled means zero real-provider network calls
RUN_REAL_PROVIDER_E2E=0
REAL_PROVIDER_E2E_PROVIDER=

# TypeScript adapter process override for local development
AGENT_TOOLS_PYTHON_CMD=

# CI-only public registry publication gates; keep disabled/empty outside protected CI variables
ENABLE_PYPI_PUBLISH=false
PYPI_TOKEN=
ENABLE_NPM_PUBLISH=false
NPM_TOKEN=

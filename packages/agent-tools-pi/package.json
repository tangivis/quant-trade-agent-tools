{
  "name": "@quant-trade/agent-tools-pi",
  "version": "0.4.0",
  "description": "pi extension exposing 12 quant_trade market, analysis and product-owned conversation tools.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangivis/quant-trade-agent-tools.git"
  },
  "homepage": "https://github.com/tangivis/quant-trade-agent-tools#readme",
  "bugs": {
    "url": "https://github.com/tangivis/quant-trade-agent-tools/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/extension.js",
  "exports": {
    "./extension": "./dist/extension.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "quant",
    "trading",
    "9984",
    "6981",
    "softbank",
    "murata",
    "japan",
    "mcp",
    "claude"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "pi": {
    "extensions": ["./dist/extension.js"],
    "skills": ["./skills/agent-tools"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "devDependencies": {
    "@quant-trade/cli-bridge": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/bun": "^1.4.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
